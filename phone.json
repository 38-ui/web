        },
        {
          "id": "6053d6ba-4c3e-4cac-9639-92b86e9008fd",
          "from": "them",
          "text": "료한테 들음",
          "time": "00:13"
        },
        {
          "id": "7e389559-2e24-4bac-bf58-c14b13a33595",
          "from": "them",
          "text": "너 그러다 후회하지마",
          "time": "00:13"
        },
        {
          "id": "a16a9b8c-4bfa-4220-afef-15e726400c1b",
          "from": "me",
          "text": "걔는 어디까지 얘기하는거야",
          "time": "00:14"
        },
        {
          "id": "91b6d809-7f26-4232-abaf-65674ab999fa",
          "from": "me",
          "text": "내가 알아서 할게",
          "time": "00:14"
        },
        {
          "id": "d6859500-dad4-4c1b-b5aa-c29a2f5c8da3",
          "from": "them",
          "text": "그래라",
          "time": "00:14"
        },
        {
          "id": "003b7479-13e0-4761-8725-97bda6ba1f6f",
          "from": "them",
          "text": "근데 나중에 후회해도 몰라",
          "time": "00:14"
        },
        {
          "id": "c172a761-3fc6-4621-a98d-fc481667cb86",
